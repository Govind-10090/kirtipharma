{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server.js" },
    { "src": "/uploads/(.*)", "dest": "server.js" },
    { "src": "/(.*\\.(html|css|js|png|jpg|jpeg|webp|gif|ico|svg|woff|woff2|ttf|json))", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/$1.html" }
  ]
}
